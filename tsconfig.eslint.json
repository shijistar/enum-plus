{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    // ensure that nobody can accidentally use this config for a build
    "noEmit": true
  },
  "include": [
    "src",
    "scripts",
    "test",
    "e2e",
    "tslib",
    "tses",
    "types-legacy",
    "packages",
    ".storybook/**/*",
    "*.ts",
    ".*.ts"
  ],
  "exclude": [
    "node_modules",
    "packages",
    "es",
    "es-legacy",
    "lib",
    "tslib",
    "tses",
    "types-legacy",
    "e2e/fixtures/scripts",
    "e2e/test-results"
  ]
}
